# ==========================================
# REQUIRED - Database
# ==========================================
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/scribesoul?sslmode=require

# ==========================================
# REQUIRED - Authentication (Neon Auth)
# ==========================================
NEON_AUTH_BASE_URL=http://localhost:3000
NEON_AUTH_COOKIE_SECRET=your-32-plus-character-random-secret

# ==========================================
# OPTIONAL - OAuth (leave blank to disable)
# ==========================================
GITHUB_ID=your-github-app-id
GITHUB_SECRET=your-github-app-secret

GOOGLE_ID=your-google-oauth-client-id
GOOGLE_SECRET=your-google-oauth-client-secret

# ==========================================
# REQUIRED - AI Services (OpenAI)
# ==========================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_AUTOCOMPLETE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# OPTIONAL - API Security
# ==========================================
INTERNAL_API_SECRET=your-internal-api-secret

# ==========================================
# OPTIONAL - Mock Auth (development only)
# ==========================================
ALLOW_MOCK_AUTH=false

# ==========================================
# OPTIONAL - Rate Limiting (Upstash Redis)
# ==========================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ==========================================
# OPTIONAL - Environment
# ==========================================
NODE_ENV=development

# ==========================================
# NOTES:
# 1. Generate NEON_AUTH_COOKIE_SECRET:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. DATABASE_URL from Neon - ensure pgvector extension enabled:
#    CREATE EXTENSION IF NOT EXISTS vector;
#
# 3. OPENAI_API_KEY from platform.openai.com
#
# 4. INTERNAL_API_SECRET: used for service-to-service auth (ingest API).
#    Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# 5. ALLOW_MOCK_AUTH: set to true only for local development without Neon Auth.
#    NEVER enable in production or Vercel deployments.
#
# 6. For Production/Vercel:
#    - Generate new NEON_AUTH_COOKIE_SECRET
#    - Update NEON_AUTH_BASE_URL to production domain
#    - Update OAuth credentials for production
#    - Set ALLOW_MOCK_AUTH=false
# ==========================================
